# Copy to .env (gitignored) and fill in. Read by lab_secrets.py and dashboard.py.
# The Docker image copies .env in at build time, so rebuild after changing it:
#   docker compose -f docker-compose.yml build

# Standard dCloud lab password: routers, switches, ISE, AD, jump host, vManage, automation PC
LAB_PASS=

# Catalyst Center login
CATC_USER=admin
CATC_PASS=

# Meraki Dashboard API key (Cloud Fabric tab, meraki_cleanup step)
MERAKI_API_KEY=
